  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "keywords": [
    "webgl",
    "webgl2",
    "shader",
    "glsl",
    "background",
    "hero",
    "gradient",
    "glass",
    "marble",
