      "default": "./src/scenes/ink-water.js"
    },
    "./topo": {
      "types": "./src/scenes/topo.d.ts",
      "import": "./src/scenes/topo.js",
      "default": "./src/scenes/topo.js"
    },
    "./oil-bubbles": {
      "types": "./src/scenes/oil-bubbles.d.ts",
      "import": "./src/scenes/oil-bubbles.js",
      "default": "./src/scenes/oil-bubbles.js"
    },
    "./melting-hologram": {
      "types": "./src/scenes/melting-hologram.d.ts",
