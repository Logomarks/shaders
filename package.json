      "import": "./src/scenes/tiles.js",
      "default": "./src/scenes/tiles.js"
    },
    "./blob": {
      "types": "./src/scenes/blob.d.ts",
      "import": "./src/scenes/blob.js",
      "default": "./src/scenes/blob.js"
    },
    "./chrome": {
      "types": "./src/scenes/chrome.d.ts",
      "import": "./src/scenes/chrome.js",
      "default": "./src/scenes/chrome.js"
    },
    "./glitter": {
      "types": "./src/scenes/glitter.d.ts",
      "import": "./src/scenes/glitter.js",
      "default": "./src/scenes/glitter.js"
    },
    "./foil": {
      "types": "./src/scenes/foil.d.ts",
      "import": "./src/scenes/foil.js",
      "default": "./src/scenes/foil.js"
