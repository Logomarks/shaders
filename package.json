    "./swirl": {
      "types": "./src/scenes/swirl.d.ts",
      "import": "./src/scenes/swirl.js",
      "default": "./src/scenes/swirl.js"
    },
    "./arches": {
      "types": "./src/scenes/arches.d.ts",
      "import": "./src/scenes/arches.js",
      "default": "./src/scenes/arches.js"
    },
    "./spheres": {
      "types": "./src/scenes/spheres.d.ts",
      "import": "./src/scenes/spheres.js",
      "default": "./src/scenes/spheres.js"
    },
    "./spheres2": {
      "types": "./src/scenes/spheres2.d.ts",
