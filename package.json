{
  "name": "@logomarks/shaders",
  "version": "0.1.1",
  "description": "WebGL 2 scene shaders: twenty full-frame backgrounds (liquid marble, frosted glass, glossy tiles, chrome, glitter, holographic foil, ink in water, oil bubbles, a melting hologram and more), each recoloured by a palette and shaped by a few named settings. Lazy WebGL contexts, an fps cap, adaptive resolution, reduced motion, and PNG stills off screen. Framework-free, no dependencies.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "import": "./src/core.js",
      "default": "./src/core.js"
    },
    "./load": {
      "types": "./src/load.d.ts",
      "import": "./src/load.js",
      "default": "./src/load.js"
    },
    "./marble": {
      "types": "./src/scenes/marble.d.ts",
      "import": "./src/scenes/marble.js",
      "default": "./src/scenes/marble.js"
    },
    "./frosted": {
      "types": "./src/scenes/frosted.d.ts",
      "import": "./src/scenes/frosted.js",
      "default": "./src/scenes/frosted.js"
    },
    "./ribs": {
      "types": "./src/scenes/ribs.d.ts",
      "import": "./src/scenes/ribs.js",
      "default": "./src/scenes/ribs.js"
    },
    "./tiles": {
